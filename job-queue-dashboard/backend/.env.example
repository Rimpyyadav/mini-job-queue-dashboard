# sqlite (default, zero setup) or postgres
DB_TYPE=sqlite

# Used when DB_TYPE=sqlite
SQLITE_PATH=data/jobs.sqlite

# Used when DB_TYPE=postgres. Most hosts (Render, Neon, Railway) give you this one URL.
DATABASE_URL=postgresql://user:password@host:5432/jobs

PORT=3000

# Comma-separated list of origins allowed to call this API.
# Use * only for local development.
CORS_ORIGINS=http://localhost:5173
